{
  "license": "GPL-3.0-or-later",
  "type": "avsync",
  "label": "Mire synchro A/V",
  "runtime": "docker",
  "badge": {
    "label": "AV Sync",
    "class": "mode-corrector",
    "oklch": "0.80 0.05 110"
  },
  "version": "0.11.0",
  "description": "Générateur de test de synchronisation image/son : flash plein écran + bip synchrones, compteur, barre de balayage, et overlay personnalisable (logo entreprise, nom du système, localisation, format vidéo, texte libre).",
  "nav": {
    "section": "sources",
    "label": "Sources",
    "route": "/receiver_2110",
    "order": 30
  },
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "script_template": "script.py",
  "brand": true,
  "deploy_defaults": {
    "width": 1280,
    "height": 720,
    "fps": 25,
    "beat_sec": 1.0,
    "flash_ms": 40,
    "tone_hz": 1000,
    "show_brand": true,
    "custom_text": "",
    "genlock": true,
    "tc_enable": false
  },
  "config_schema": [
    {
      "key": "width",
      "type": "number",
      "label": "Largeur (px)",
      "min": 320,
      "max": 3840,
      "step": 2,
      "default": 1280,
      "scope": "user"
    },
    {
      "key": "height",
      "type": "number",
      "label": "Hauteur (px)",
      "min": 180,
      "max": 2160,
      "step": 2,
      "default": 720,
      "scope": "user"
    },
    {
      "key": "fps",
      "type": "number",
      "label": "Fréquence (fps)",
      "min": 1,
      "max": 60,
      "default": 25,
      "scope": "user"
    },
    {
      "key": "chroma",
      "type": "select",
      "label": "Chroma",
      "default": "422",
      "options": [
        {
          "value": "420",
          "label": "YUV 4:2:0"
        },
        {
          "value": "422",
          "label": "YUV 4:2:2"
        },
        {
          "value": "444",
          "label": "YUV 4:4:4"
        }
      ],
      "scope": "user"
    },
    {
      "key": "beat_sec",
      "type": "number",
      "label": "Battement (s)",
      "min": 0.2,
      "max": 10,
      "step": 0.1,
      "default": 1.0,
      "scope": "user"
    },
    {
      "key": "flash_ms",
      "type": "number",
      "label": "Durée flash + bip (ms)",
      "min": 10,
      "max": 500,
      "default": 40,
      "scope": "user"
    },
    {
      "key": "tone_hz",
      "type": "number",
      "label": "Fréquence bip (Hz)",
      "min": 100,
      "max": 12000,
      "default": 1000,
      "scope": "user"
    },
    {
      "key": "tc_enable",
      "type": "bool",
      "label": "Générateur de timecode (incrusté + flux ANC)",
      "help": "Incruste le timecode (heure du jour, hh:mm:ss:img) sous le compteur ET émet un flux ANC ATC RP 188 (RFC 8331) câblable — ex. vers le port ANC d'une fenêtre de multiview.",
      "default": false,
      "scope": "user"
    },
    {
      "key": "custom_text",
      "type": "text",
      "label": "Texte personnalisé",
      "placeholder": "ex. Banc d'essai — Régie A",
      "scope": "user"
    },
    {
      "key": "show_brand",
      "type": "checkbox",
      "label": "Afficher la marque (logo + nom + lieu)",
      "default": true,
      "scope": "user"
    },
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    }
  ],
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}",
        "label": "Vidéo"
      },
      {
        "essence": "audio",
        "shm": "{hostname}_audio",
        "label": "Audio"
      },
      {
        "essence": "data",
        "shm": "{hostname}_anc",
        "label": "TC (ANC)",
        "repeat": "tc_enable"
      }
    ],
    "consumes": [],
    "mode": "redeploy"
  },
  "control": {
    "endpoints": [
      "/state",
      "/config"
    ]
  },
  "actions": [
    {
      "id": "beat",
      "label": "Régler la période du beat (s)",
      "endpoint": "/config",
      "params": [
        {
          "key": "beat_sec",
          "label": "Période (s)",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "id": "tone",
      "label": "Régler la fréquence du bip (Hz)",
      "endpoint": "/config",
      "params": [
        {
          "key": "tone_hz",
          "label": "Fréquence (Hz)",
          "type": "number",
          "default": 1000
        }
      ]
    },
    {
      "id": "brand",
      "label": "Afficher l'habillage",
      "endpoint": "/config",
      "params": [
        {
          "key": "show_brand",
          "label": "Affiché",
          "type": "bool",
          "default": true
        }
      ],
      "feedback": {
        "state": "show_brand",
        "value_from": "show_brand"
      }
    },
    {
      "id": "text",
      "label": "Changer le texte personnalisé",
      "endpoint": "/config",
      "params": [
        {
          "key": "custom_text",
          "label": "Texte",
          "type": "text",
          "default": ""
        }
      ]
    }
  ],
  "state": [
    {
      "id": "beat_sec",
      "label": "Période du beat (s)",
      "endpoint": "/state",
      "path": "beat_sec",
      "type": "number"
    },
    {
      "id": "show_brand",
      "label": "Habillage affiché",
      "endpoint": "/state",
      "path": "show_brand",
      "type": "bool"
    },
    {
      "id": "custom_text",
      "label": "Texte personnalisé",
      "endpoint": "/state",
      "path": "custom_text",
      "type": "text"
    },
    {
      "id": "fps_live",
      "label": "FPS mesuré",
      "endpoint": "/state",
      "path": "fps_live",
      "type": "number"
    }
  ]
}
