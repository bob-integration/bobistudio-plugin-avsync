{
  "license": "GPL-3.0-or-later",
  "type": "avsync",
  "label": "Mire synchro A/V",
  "runtime": "docker",
  "badge": {
    "label": "AV Sync",
    "class": "mode-corrector",
    "oklch": "0.80 0.05 110"
  },
  "version": "0.24.3",
  "description": "Générateur de test de synchronisation image/son : flash plein écran + bip synchrones, compteur, barre de balayage, et overlay personnalisable (logo entreprise, nom du système, localisation, format vidéo, texte libre).",
  "nav": {
    "section": "sources",
    "label": "Sources",
    "route": "/sources",
    "order": 30,
    "group": "generateurs"
  },
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "script_template": "script.py",
  "brand": true,
  "deploy_defaults": {
    "width": 1280,
    "height": 720,
    "fps": 25,
    "beat_sec": 1.0,
    "flash_ms": 40,
    "tone_hz": 1000,
    "show_brand": true,
    "custom_text": "",
    "font": "dejavu-sans-bold",
    "genlock": true,
    "tc_enable": false,
    "log_level": "info",
    "probe_bands": 0,
    "probe_layout": "tranche",
    "audio_marque": "bip"
  },
  "config_schema": [
    {
      "key": "width",
      "type": "number",
      "label": "Largeur (px)",
      "min": 320,
      "max": 3840,
      "step": 2,
      "default": 1280,
      "scope": "user"
    },
    {
      "key": "height",
      "type": "number",
      "label": "Hauteur (px)",
      "min": 180,
      "max": 2160,
      "step": 2,
      "default": 720,
      "scope": "user"
    },
    {
      "key": "fps",
      "type": "number",
      "label": "Fréquence (fps)",
      "min": 1,
      "max": 60,
      "default": 25,
      "scope": "user"
    },
    {
      "key": "chroma",
      "type": "select",
      "label": "Chroma",
      "default": "422",
      "options": [
        {
          "value": "420",
          "label": "YUV 4:2:0"
        },
        {
          "value": "422",
          "label": "YUV 4:2:2"
        },
        {
          "value": "444",
          "label": "YUV 4:4:4"
        }
      ],
      "scope": "user"
    },
    {
      "key": "beat_sec",
      "type": "number",
      "label": "Battement (s)",
      "min": 0.2,
      "max": 10,
      "step": 0.1,
      "default": 1.0,
      "scope": "user"
    },
    {
      "key": "flash_ms",
      "type": "number",
      "label": "Durée flash + bip (ms)",
      "min": 10,
      "max": 500,
      "default": 40,
      "scope": "user"
    },
    {
      "key": "tone_hz",
      "type": "number",
      "label": "Fréquence bip (Hz)",
      "min": 100,
      "max": 12000,
      "default": 1000,
      "scope": "user"
    },
    {
      "key": "tc_enable",
      "type": "bool",
      "label": "Générateur de timecode (incrusté + flux ANC)",
      "help": "Incruste le timecode (heure du jour, hh:mm:ss:img) sous le compteur ET émet un flux ANC ATC RP 188 (RFC 8331) câblable — ex. vers le port ANC d'une fenêtre de multiview.",
      "default": false,
      "scope": "user"
    },
    {
      "key": "custom_text",
      "type": "text",
      "label": "Texte personnalisé",
      "placeholder": "ex. Banc d'essai — Régie A",
      "scope": "user"
    },
    {
      "key": "font",
      "type": "text",
      "label": "Police (habillage + timecode)",
      "help": "Alimenté par le sélecteur BobiFonts (polices d'image + bibliothèque). Changer la police redéploie le conteneur (nécessaire pour embarquer les octets d'une police de la bibliothèque — rootfs éphémère).",
      "default": "dejavu-sans-bold",
      "scope": "user"
    },
    {
      "key": "show_brand",
      "type": "checkbox",
      "label": "Afficher la marque (logo + nom + lieu)",
      "default": true,
      "scope": "user"
    },
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "log_level",
      "type": "select",
      "label": "Niveau de log",
      "help": "Verbosité du journal du conteneur. Défaut « Événements » : les faits marquants (démarrage/arrêt, changement de format, reconnexion, repli sur un chemin dégradé, entrée qui apparaît ou disparaît) sont TOUJOURS écrits — après une panne le journal doit permettre de reconstituer l'histoire, et élever le niveau après coup ne récupère rien. Les métriques périodiques (fps, compteurs) ne sont PAS journalisées : elles sont déjà publiées sur :8080. « Détaillé » = lance-flammes par trame, à n'activer que le temps d'un diagnostic (le journal Docker n'est pas roté).",
      "options": [
        {
          "value": "debug",
          "label": "Détaillé (par trame — diagnostic ponctuel)"
        },
        {
          "value": "info",
          "label": "Événements (défaut)"
        },
        {
          "value": "warning",
          "label": "Anomalies seules"
        },
        {
          "value": "error",
          "label": "Erreurs seules"
        }
      ],
      "default": "info",
      "scope": "user"
    },
    {
      "key": "probe_bands",
      "type": "int",
      "label": "Bandeaux-sonde (0 = éteint)",
      "help": "Nombre de bandeaux de blocs binaires répartis sur la hauteur, portant l'index de grain ET le numéro de bande. Sert à mesurer la latence RÉELLE bande par bande et à détecter un déchirement (deux bandes d'index différents) — ce qu'un timecode unique au centre ne permet pas. 0 = désactivé (défaut, coût nul). 8 convient.",
      "min": 0,
      "max": 16,
      "default": 0
    },
    {
      "key": "probe_layout",
      "type": "select",
      "label": "Disposition des bandeaux-sonde",
      "help": "« Tranche » : les bandeaux occupent toute la largeur, répartis sur la hauteur — c'est ce qui permet de mesurer la latence LIGNE PAR LIGNE (un producteur en mode tranche livre le haut de l'image avant le bas) et de voir un déchirement. Intrusif : l'image est barrée de bandes. « Bords » : deux cartouches encadrés, en haut et en bas, hors de la zone utile — suppose que l'image arrive ENTIÈRE (pas de mesure sous-image, pas de détection de déchirement fiable), mais l'incrustation est discrète et lisible. À chaud.",
      "options": [
        {
          "value": "tranche",
          "label": "Tranche — pleine largeur, mesure ligne par ligne"
        },
        {
          "value": "bords",
          "label": "Bords — cartouches haut/bas, image préservée"
        }
      ],
      "default": "tranche"
    },
    {
      "key": "audio_marque",
      "type": "select",
      "label": "Marque audio",
      "help": "« Bip » : le bip historique de 1 kHz au battement — repère à l'oreille, mais il ne porte AUCUNE information : deux bips sont indiscernables, donc un décalage d'une seconde entière est invisible. « Marque de mesure » : un chirp d'ancrage suivi de créneaux de tons codant le numéro de battement (64 avant répétition, avec somme de contrôle). C'est ce qui permet de dater l'audio à travers une liaison COMPRIMÉE, où aucun index de grain ne survit — donc de mesurer l'écart A/V inter-site. À chaud.",
      "options": [
        {
          "value": "bip",
          "label": "Bip 1 kHz (repère à l'oreille)"
        },
        {
          "value": "chirp",
          "label": "Marque de mesure (chirp + compteur de battements)"
        }
      ],
      "default": "bip"
    }
  ],
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}",
        "label": "Vidéo"
      },
      {
        "essence": "audio",
        "shm": "{hostname}_audio",
        "label": "Audio"
      },
      {
        "essence": "data",
        "shm": "{hostname}_anc",
        "label": "TC (ANC)",
        "repeat": "tc_enable"
      }
    ],
    "consumes": [],
    "mode": "redeploy"
  },
  "control": {
    "endpoints": [
      "/state",
      "/config",
      "/log_level"
    ],
    "read_endpoints": [
      "/state"
    ]
  },
  "param_tree": {
    "global_groups": [
      {
        "label": "Mire visuelle",
        "endpoint": "/config",
        "fields": {
          "beat_sec": {
            "label": "Battement (s)",
            "type": "number",
            "min": 0.2,
            "max": 10.0,
            "default": 1.0
          },
          "flash_ms": {
            "label": "Durée flash + bip (ms)",
            "type": "number",
            "min": 10,
            "max": 500,
            "default": 40
          }
        }
      },
      {
        "label": "Mire sonore",
        "endpoint": "/config",
        "fields": {
          "tone_hz": {
            "label": "Fréquence bip (Hz)",
            "type": "number",
            "min": 100,
            "max": 12000,
            "default": 1000
          }
        }
      },
      {
        "label": "Habillage",
        "endpoint": "/config",
        "fields": {
          "show_brand": {
            "label": "Afficher la marque",
            "type": "bool",
            "default": true
          },
          "custom_text": {
            "label": "Texte personnalisé",
            "type": "text",
            "default": ""
          }
        }
      },
      {
        "label": "Timecode",
        "endpoint": "/config",
        "fields": {
          "tc_enable": {
            "label": "Générateur de timecode",
            "type": "bool",
            "default": false
          }
        }
      },
      {
        "label": "Sonde de latence",
        "endpoint": "/config",
        "fields": {
          "probe_bands": {
            "label": "Bandeaux-sonde (0 = éteint)",
            "type": "number",
            "min": 0,
            "max": 16,
            "default": 0
          },
          "probe_layout": {
            "label": "Disposition",
            "type": "enum",
            "options": [
              "tranche",
              "bords"
            ],
            "default": "tranche"
          },
          "audio_marque": {
            "label": "Marque audio",
            "type": "enum",
            "options": [
              "bip",
              "chirp"
            ],
            "default": "bip"
          }
        }
      },
      {
        "label": "Journal (diagnostic)",
        "endpoint": "/log_level",
        "fields": {
          "level": {
            "label": "Niveau de log",
            "type": "enum",
            "options": [
              "debug",
              "info",
              "warning",
              "error"
            ],
            "default": "info",
            "path": "log_level"
          }
        }
      }
    ]
  },
  "actions": [
    {
      "id": "probe_bands",
      "label": "Bandeaux-sonde (nombre, 0 = éteint)",
      "endpoint": "/config",
      "params": [
        {
          "key": "probe_bands",
          "label": "Bandeaux",
          "type": "number",
          "min": 0,
          "max": 16,
          "default": 8
        }
      ],
      "feedback": {
        "state": "probe_bands",
        "value_from": "probe_bands"
      }
    },
    {
      "id": "probe_layout",
      "label": "Disposition des bandeaux-sonde",
      "endpoint": "/config",
      "params": [
        {
          "key": "probe_layout",
          "label": "Disposition",
          "type": "enum",
          "options": [
            "tranche",
            "bords"
          ],
          "default": "tranche"
        }
      ],
      "feedback": {
        "state": "probe_layout",
        "value_from": "probe_layout"
      }
    },
    {
      "id": "audio_marque",
      "label": "Marque audio (bip ou marque de mesure)",
      "endpoint": "/config",
      "params": [
        {
          "key": "audio_marque",
          "label": "Marque",
          "type": "enum",
          "options": [
            "bip",
            "chirp"
          ],
          "default": "bip"
        }
      ],
      "feedback": {
        "state": "audio_marque",
        "value_from": "audio_marque"
      }
    },
    {
      "id": "beat",
      "label": "Régler la période du beat (s)",
      "endpoint": "/config",
      "params": [
        {
          "key": "beat_sec",
          "label": "Période (s)",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "id": "tone",
      "label": "Régler la fréquence du bip (Hz)",
      "endpoint": "/config",
      "params": [
        {
          "key": "tone_hz",
          "label": "Fréquence (Hz)",
          "type": "number",
          "default": 1000
        }
      ]
    },
    {
      "id": "brand",
      "label": "Afficher l'habillage",
      "endpoint": "/config",
      "params": [
        {
          "key": "show_brand",
          "label": "Affiché",
          "type": "bool",
          "default": true
        }
      ],
      "feedback": {
        "state": "show_brand",
        "value_from": "show_brand"
      }
    },
    {
      "id": "text",
      "label": "Changer le texte personnalisé",
      "endpoint": "/config",
      "params": [
        {
          "key": "custom_text",
          "label": "Texte",
          "type": "text",
          "default": ""
        }
      ]
    },
    {
      "id": "log_level",
      "label": "Niveau de log (à chaud)",
      "endpoint": "/log_level",
      "params": [
        {
          "key": "level",
          "label": "Niveau",
          "type": "text",
          "default": "info",
          "options": [
            {
              "value": "debug",
              "label": "Détaillé"
            },
            {
              "value": "info",
              "label": "Événements (défaut)"
            },
            {
              "value": "warning",
              "label": "Anomalies seules"
            },
            {
              "value": "error",
              "label": "Erreurs seules"
            }
          ]
        }
      ]
    }
  ],
  "state": [
    {
      "id": "beat_sec",
      "label": "Période du beat (s)",
      "endpoint": "/state",
      "path": "beat_sec",
      "type": "number"
    },
    {
      "id": "show_brand",
      "label": "Habillage affiché",
      "endpoint": "/state",
      "path": "show_brand",
      "type": "bool"
    },
    {
      "id": "custom_text",
      "label": "Texte personnalisé",
      "endpoint": "/state",
      "path": "custom_text",
      "type": "text"
    },
    {
      "id": "fps_live",
      "label": "FPS mesuré",
      "endpoint": "/state",
      "path": "fps_live",
      "type": "number"
    }
  ]
}
